---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const frames = [
  ['Money order finder', 'money-order-finder', 820],
  ['Check hold calculator', 'check-hold-calculator', 860],
  ['Transfer limits by bank', 'transfer-limits', 820],
] as const;
const code = (title: string, slug: string, hgt: number) => `<iframe src="${SITE_URL}/embed/${slug}/" title="${title}" width="100%" height="${hgt}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free money order finder or check hold calculator" description="Put the money order finder, the Regulation CC check hold calculator or the bank limits table on your site: one iframe, no sign-up, no cookie, no tracking and no cost at all." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a money tool</h1>
    <p class="mt-3 text-lg text-navy-700">For credit unions, housing counselors, tenant groups, libraries and blogs that help people pay and get paid.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {frames.map(([title, slug, hgt]) => (<><h2>{title}</h2><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(title, slug, hgt)}</code></pre></>))}
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When a fee, a limit or a federal amount changes, the embedded tool follows. Nothing your visitors type reaches us and the frame sets no cookie and makes no outside request. Each frame states that the site is independent and not a bank or a store. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/check-hold-calculator/" title="Check hold calculator" width="100%" height="860" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
